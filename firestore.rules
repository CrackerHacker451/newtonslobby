rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Newton's Lobby Squads & Subcollections ────────────────────────────────
    match /hl_teams/{teamId} {
      allow read: if true;
      allow write: if true;
      
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }

    // ── Newton's Lobby Builder Profiles & Badges ──────────────────────────────
    match /hl_users/{uid} {
      allow read: if true;
      allow write: if true;
    }

    // ── Legacy / Shared Squad Collections ─────────────────────────────────────
    match /hackathon_teams/{teamId} {
      allow read, write: if true;
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }

    // ── Video Chat & WebRTC Signaling ─────────────────────────────────────────
    match /calls/{callId} {
      allow read, write: if true;
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }

    match /users/{uid} {
      allow read, write: if true;
    }

    match /sessions/{sessionId} {
      allow read, write: if true;
      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }
  }
}
