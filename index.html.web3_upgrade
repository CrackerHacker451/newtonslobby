    let currentCategory = 'all';

    function renderVaultGrid(items) {
      const grid = document.getElementById('vault-grid');
      grid.innerHTML = items.map(item => `
        <div class="vault-card">
          <div class="vault-card-header">
            <div>
              <div class="vault-file-title">${item.title}</div>
              <div style="font-size:0.75rem; color:var(--c-cyan); margin-top:0.2rem;">By ${item.author}</div>
            </div>
            <span class="vault-ttl-tag">Expires in ${item.ttlDays}d</span>
          </div>

          <div class="vault-meta-list">
            <div class="vault-meta-item">
              <span>Arkiv Entity:</span>
              <span style="color:#fff;">${item.id}</span>
            </div>
            <div class="vault-meta-item">
              <span>Swarm BZZ:</span>
              <span style="color:var(--c-gold);">${item.swarmHash}</span>
            </div>
            <div class="vault-meta-item">
              <span>Expiration Policy:</span>
              <span>ExpirationTime.fromDays(30)</span>
            </div>
          </div>

          <div class="vault-card-actions">
            <button class="vault-action-btn vault-action-preview" onclick="openPdfViewer('${item.title}', '${item.previewText.replace(/'/g, "\\'")}', '${item.swarmHash}')">
              <span>👁️ Preview PDF</span>
            </button>
            <button class="vault-action-btn vault-action-swarm" onclick="downloadVaultDocument('${item.title}')">
              <span>🐝 Swarm BZZ</span>
            </button>
          </div>
        </div>
      `).join('');
    }
    renderVaultGrid(VAULT_ITEMS);

    function filterVault() {
      const query = document.getElementById('vault-search').value.toLowerCase();
      const filtered = VAULT_ITEMS.filter(item => {
        const matchesCat = currentCategory === 'all' || item.category === currentCategory;
        const matchesQ = item.title.toLowerCase().includes(query) || item.author.toLowerCase().includes(query);
        return matchesCat && matchesQ;
      });
      renderVaultGrid(filtered);
    }

    function setVaultCategory(cat, btn) {
      playAudio('click');
      currentCategory = cat;
      document.querySelectorAll('.filter-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterVault();
    }

    function openPdfViewer(title, text, hash) {
      playAudio('click');
      document.getElementById('pdf-view-title').textContent = title;
      document.getElementById('pdf-view-hash').textContent = `Swarm Hash: ${hash}`;
      document.getElementById('pdf-view-body').innerHTML = `
        <div style="border-bottom: 1px solid var(--border-glass); padding-bottom: 1rem; margin-bottom: 1.5rem;">
          <h2 style="color:var(--c-cyan); margin-bottom: 0.5rem;">${title}</h2>
          <div style="font-size:0.8rem; color:var(--c-lime); font-family:var(--font-mono);">
            ✔ Verified on Arkiv DB-Chain (30-Day TTL) • Swarm AES-256 Encrypted
          </div>
        </div>
        <p style="font-size:1.05rem; margin-bottom:1.5rem;">${text}</p>
        <div style="margin-top: 2rem; padding: 1.5rem; background: rgba(0,0,0,0.5); border-radius: 8px; font-family: var(--font-mono); font-size: 0.85rem; color: #94A3B8;">
          // ON-CHAIN AUDIT DATA<br>
          Entity_Owner: 0x3F89a019b88127cA9b4e5f6A10B981C48D7C0F4D<br>
          Network: Arkiv Network DB-Chain Mainnet<br>
          Swarm_Manifest: ${hash}<br>
          Verification_Status: PASSED (100% Zero-Knowledge Match)
        </div>
      `;
      openModal('modal-pdf');
    }

    function downloadVaultDocument(title = "Study_Notes") {
      playAudio('click');
      const blob = new Blob([`Newton's Lobby Verified Academic Document\nTitle: ${title}\nEncrypted on Swarm BZZ\nAttested by Arkiv Network DB-Chain`], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${title.replace(/\s+/g, '_')}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('success', 'Download Started', `Saved ${title} to your device.`);
    }

    function openVaultUploadModal() {
      playAudio('click');
      openModal('modal-publish');
    }

    function submitNewVaultDoc() {
      const title = document.getElementById('pub-title').value.trim();
      const cat = document.getElementById('pub-cat').value;
      const summary = document.getElementById('pub-summary').value.trim();

      if (!title) {
        showToast('error', 'Validation Error', 'Please enter a document title.');
        return;
      }

      VAULT_ITEMS.unshift({
        id: "ark_ent_" + Math.floor(Math.random() * 900 + 100),
        title: title,
        category: cat,
        author: "Current Student (You)",
        swarmHash: "bzz://" + Math.random().toString(16).substring(2, 10) + "...zk",
        ttlDays: 30,
        previewText: summary || "Newly committed document on Arkiv Network DB-Chain with 30-day time-scoped expiration."
      });

      renderVaultGrid(VAULT_ITEMS);
      closeModal('modal-publish');
      showToast('success', 'Published to Arkiv', 'Document committed with ExpirationTime.fromDays(30)!');
    }

    /* ──────────────────────────────────────────────────────────────────────
       9. SPEEDLINK 1080p & REELS LIVE STAGE
       ────────────────────────────────────────────────────────────────────── */
    let localStream = null;
    let micMuted = false;
    let camMuted = false;

    function switchSpeedlinkSub(sub) {
      playAudio('click');
      document.getElementById('btn-sub-speed').classList.toggle('active', sub === 'speed');
      document.getElementById('btn-sub-reels').classList.toggle('active', sub === 'reels');
      document.getElementById('subview-speed').style.display = sub === 'speed' ? 'block' : 'none';
      document.getElementById('subview-reels').style.display = sub === 'reels' ? 'block' : 'none';
    }

    async function startWebcam() {
      try {
        localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        const video = document.getElementById('local-video');
        video.srcObject = localStream;
        document.getElementById('local-fallback').style.display = 'none';
        playAudio('success');
        showToast('success', 'Camera Active', '1080p WebRTC camera stream is now broadcasting.');
      } catch (e) {
        showToast('info', 'Simulated Camera', 'Hardware camera permission not granted. Running simulated 120fps cyber avatar feed.');
      }
    }

    function toggleMic() {
      playAudio('click');
      micMuted = !micMuted;
      document.getElementById('btn-mute-mic').textContent = micMuted ? '🔇' : '🎤';
      if (localStream) {
        localStream.getAudioTracks().forEach(track => track.enabled = !micMuted);
      }
      showToast('info', 'Microphone', micMuted ? 'Muted' : 'Unmuted');
    }

    function toggleCam() {
      playAudio('click');
      camMuted = !camMuted;
      document.getElementById('btn-toggle-cam').textContent = camMuted ? '🚫' : '📹';
      if (localStream) {
        localStream.getVideoTracks().forEach(track => track.enabled = !camMuted);
      }
      showToast('info', 'Camera Feed', camMuted ? 'Video Paused' : 'Video Resumed');
    }

    const PEER_STUDENTS = [
      { name: "Dev Sharma", college: "IIIT Bangalore • Full-Stack Dev", avatar: "💻" },
      { name: "Priya Kumar", college: "Bangalore S-VYASA • Data Science", avatar: "👩‍💻" },
      { name: "K.M. Usha", college: "Bangalore S-VYASA • Computer Vision", avatar: "🧠" },
      { name: "Chandrakala M", college: "RV College of Engineering • Frontend", avatar: "⚡" },
      { name: "Sourav Paul", college: "IIT Delhi • ZK Cryptographer", avatar: "🛡️" }
    ];
    let peerIdx = 0;

    function nextSpeedMatch() {
      playAudio('beep');
      peerIdx = (peerIdx + 1) % PEER_STUDENTS.length;
      const peer = PEER_STUDENTS[peerIdx];

      document.getElementById('remote-partner-name').textContent = peer.name;
      document.getElementById('remote-partner-college').textContent = peer.college;
      document.getElementById('remote-avatar').textContent = peer.avatar;

      // Append greeting in chat
      const chatBox = document.getElementById('speed-chat-box');
      chatBox.innerHTML += `
        <div class="chat-bubble peer">
          <strong>${peer.name.split(' ')[0]}:</strong> Connected! Let's build together.
        </div>
      `;
      chatBox.scrollTop = chatBox.scrollHeight;
      showToast('success', 'Matched!', `Connected with ${peer.name} (${peer.college.split('•')[0]}).`);
    }

    function sendSpeedChat() {
      const input = document.getElementById('speed-chat-input');
      const text = input.value.trim();
      if (!text) return;

      playAudio('click');
      const chatBox = document.getElementById('speed-chat-box');
      chatBox.innerHTML += `
        <div class="chat-bubble me">
          <strong>You:</strong> ${text}
        </div>
      `;
      input.value = '';
      chatBox.scrollTop = chatBox.scrollHeight;

      // Simulated peer reply
      setTimeout(() => {
        chatBox.innerHTML += `
          <div class="chat-bubble peer">
            <strong>Peer:</strong> Sounds like a plan! Let's link up on GitHub.
          </div>
        `;
        chatBox.scrollTop = chatBox.scrollHeight;
        playAudio('beep');
      }, 900);
    }

    // Simulated Canvas Peer Waveform Video Feed
    let peerAnimRunning = false;
    function startRemotePeerSimulation() {
      if (peerAnimRunning) return;
      peerAnimRunning = true;
      const peerCanvas = document.getElementById('remote-peer-canvas');
      if (!peerCanvas) return;
      const pctx = peerCanvas.getContext('2d');

      function drawPeer() {
        if (peerCanvas.width !== peerCanvas.clientWidth) {
          peerCanvas.width = peerCanvas.clientWidth || 300;
          peerCanvas.height = peerCanvas.clientHeight || 200;
        }
        const pw = peerCanvas.width;
        const ph = peerCanvas.height;

        pctx.fillStyle = '#060A10';
        pctx.fillRect(0, 0, pw, ph);

        const time = Date.now() * 0.002;
        pctx.beginPath();
        for (let x = 0; x < pw; x += 4) {
          const y = ph / 2 + Math.sin(x * 0.02 + time) * 20 * Math.sin(time * 0.5);
          if (x === 0) pctx.moveTo(x, y);
          else pctx.lineTo(x, y);
        }
        pctx.strokeStyle = 'rgba(6, 182, 212, 0.4)';
        pctx.lineWidth = 2;
        pctx.stroke();

        requestAnimationFrame(drawPeer);
      }
      drawPeer();
    }

    // Reels Switcher
    const REELS = [
      {
        creator: "@rohit_builds",
        caption: "Rebuilding our entire AI agent architecture 3 hours before hackathon submission 🚀 #NewtonsLobby",
        likes: "1.4k",
        color: "linear-gradient(135deg, #1e1b4b, #0f172a, #042f2e)"
      },
      {
        creator: "@ananya_ai",
        caption: "Testing 0G Private Computer ZK proofs on our mobile React Native client! 18ms latency! 🤯",
        likes: "2.8k",
        color: "linear-gradient(135deg, #4c0519, #1e1b4b, #022c22)"
      },
      {
        creator: "@dev_club_bangalore",
        caption: "When your team member says 'it works on my machine' during SIH jury evaluation 😂",
        likes: "4.1k",
        color: "linear-gradient(135deg, #14532d, #0f172a, #3b0764)"
      }
    ];
    let reelIndex = 0;

    function updateReelDisplay() {
      const reel = REELS[reelIndex];
      document.getElementById('reel-creator').textContent = reel.creator;
      document.getElementById('reel-caption').textContent = reel.caption;
      document.getElementById('reel-like-count').textContent = reel.likes;
      document.getElementById('reel-bg-visual').style.background = reel.color;
    }

    function nextReel() {
      playAudio('click');
      reelIndex = (reelIndex + 1) % REELS.length;
      updateReelDisplay();
    }

    function prevReel() {
      playAudio('click');
      reelIndex = (reelIndex - 1 + REELS.length) % REELS.length;
      updateReelDisplay();
    }

    function likeReel(btn) {
      playAudio('success');
      btn.style.transform = 'scale(1.35)';
      btn.style.color = 'var(--c-magenta)';
      showToast('success', 'Liked Reel', 'Added to your verified favorites.');
      setTimeout(() => btn.style.transform = 'scale(1)', 200);
    }

    function openReelComments() {
      playAudio('click');
      showToast('info', 'Live Comments', 'Decentralized comments synchronized with Arkiv DB-Chain.');
    }

    function shareReel() {
      playAudio('click');
      navigator.clipboard?.writeText(window.location.href);
      showToast('success', 'Link Copied', 'Reel link copied to clipboard!');
    }

    /* ──────────────────────────────────────────────────────────────────────
       10. MODAL CONTROLS & WEB3 SIMULATIONS
       ────────────────────────────────────────────────────────────────────── */
    function openModal(modalId) {
      playAudio('click');
      document.getElementById(modalId).classList.add('active');
    }

    function closeModal(modalId) {
      playAudio('click');
      document.getElementById(modalId).classList.remove('active');
    }

    function openApkModal() { openModal('modal-apk'); }
    function openWorldIdModal() { openModal('modal-worldid'); }
    function openProofModal() { openModal('modal-proof'); }
    function openPrivacyModal() { showToast('info', 'Zero-Knowledge Privacy', 'Iris hashes are converted to cryptographic nullifiers. No biometric data ever leaves your device.'); }
    function openTermsModal() { showToast('info', 'Campus Terms', 'Adhere to university honor codes, respectful squad conduct, and academic integrity.'); }

    function triggerApkDownload() {
      playAudio('success');
      showToast('success', 'Starting APK Download', 'Downloading official Newton\'s Lobby Android APK (76.8 MB)...');
      // Direct anchor trigger
      const a = document.createElement('a');
      a.href = '/newtonslobby.apk';
      a.download = 'newtonslobby.apk';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    function simulateWorldIdVerification() {
      const btn = document.getElementById('btn-run-worldid');
      const eye = document.getElementById('orb-eye-icon');
      btn.textContent = "Scanning Orb Proof...";
      btn.disabled = true;
      eye.style.transform = 'scale(1.3) rotate(15deg)';
      playAudio('beep');

      setTimeout(() => {
        btn.textContent = "Generating Cryptographic Nullifier...";
        eye.style.transform = 'scale(1) rotate(0deg)';
      }, 700);

      setTimeout(() => {
        btn.textContent = "Verified ✔";
        btn.style.background = "linear-gradient(135deg, var(--c-lime), #15803D)";
        btn.disabled = false;
        document.getElementById('worldid-status-box').style.display = 'block';
        document.getElementById('badge-world-tag').textContent = 'ORB CONFIRMED';
        document.getElementById('nav-world-btn').innerHTML = '<span>🟢 Orb Verified</span>';
        playAudio('success');
        showToast('success', 'World ID 4.0 Verified', 'Sybil-resistant proof validated on World ID 4.0 IDKit.');
      }, 1500);
    }

    function triggerProofCapture() {
      playAudio('click');
      document.getElementById('proof-upload-prompt').style.display = 'none';
      const video = document.getElementById('proof-recorded-video');
      video.style.display = 'block';
      document.getElementById('zk-laser-scanner').style.display = 'block';
      showToast('info', 'Video Loaded', 'Entry video ready for 0G ZK Computer Vision analysis.');
    }

    function executeProofVerification() {
      const steps = document.getElementById('zk-verify-steps');
      steps.style.display = 'block';
      playAudio('beep');

      setTimeout(() => {
        document.getElementById('zk-step-1').innerHTML = '✔ [1/3] Neural landmark frames extracted!';
        document.getElementById('zk-step-2').style.color = 'var(--c-cyan)';
      }, 600);

      setTimeout(() => {
        document.getElementById('zk-step-2').innerHTML = '✔ [2/3] 0G ZK-SNARK constraint proof verified!';
        document.getElementById('zk-step-3').style.color = 'var(--c-cyan)';
      }, 1200);

      setTimeout(() => {
        document.getElementById('zk-step-3').innerHTML = '✔ [3/3] Attested to Arkiv DB-Chain!';
        playAudio('success');
        showToast('success', 'Dare Approved!', '$500 USDC + 350 iAI credits dispatched to your verified wallet.');
        closeModal('modal-proof');

        // Prepend to recent feed
        RECENT_PROOFS.unshift({
          student: "Current Builder (You)",
          dare: document.getElementById('active-dare-title').textContent,
          time: "Just now",
          prize: "$500 USDC"
        });
        renderRecentProofs();
      }, 1800);
    }

    // 3D Lanyard Card tilt effect on mousemove
    const lanyardCard = document.getElementById('lanyard-card-element');
    window.addEventListener('mousemove', (e) => {
      if (!lanyardCard || !document.getElementById('modal-pass').classList.contains('active')) return;
      const rect = lanyardCard.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      lanyardCard.style.transform = `rotateY(${x * 0.08}deg) rotateX(${-y * 0.08}deg)`;
    });

    // Close modals on clicking backdrop
    window.addEventListener('click', (e) => {
      if (e.target.classList.contains('modal-backdrop')) {
        e.target.classList.remove('active');
      }
    });

    // Keyboard navigation for reels
    window.addEventListener('keydown', (e) => {
      if (document.getElementById('section-speedlink').classList.contains('active')) {
        if (e.key === 'ArrowDown') nextReel();
        if (e.key === 'ArrowUp') prevReel();
      }
    });
  </script>
</body>
</html>
