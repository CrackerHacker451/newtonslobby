    function renderLobbySquads() {
      const container = document.getElementById('squads-container');
      container.innerHTML = SQUADS_DATA.map(sq => {
        const fillPercent = Math.round((sq.current / sq.max) * 100);
        return `
          <div class="squad-card">
            <div class="squad-top-row">
              <div>
                <div class="squad-name">${sq.name}</div>
                <span class="squad-hackathon-tag">${sq.hackathon}</span>
              </div>
              <span class="status-tag verified">${sq.current}/${sq.max} MEMBERS</span>
            </div>
            <div class="squad-desc">${sq.description}</div>
            <div class="squad-members-wrap">
              <div class="squad-members-header">
                <span>Roster Capacity</span>
                <span>${fillPercent}% Full</span>
              </div>
              <div class="squad-roster-meter">
                <div class="squad-meter-fill" style="width: ${fillPercent}%;"></div>
              </div>
              <div class="squad-avatar-row">
                ${sq.members.map(m => `
                  <span class="member-avatar-chip" title="${m.name} (${m.college})">
                    <span>👤</span> ${m.name.split(' ')[0]}
                  </span>
                `).join('')}
              </div>
            </div>
            <div class="squad-actions-row">
              <button class="squad-join-btn" onclick="joinSquadAction('${sq.name}')">
                <span>+ Join Squad 🤝</span>
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderLobbyBuilders() {
      const container = document.getElementById('builders-container');
      container.innerHTML = STUDENTS_DATA.map(st => `
        <div class="builder-card">
          <div class="builder-header">
            <div class="builder-avatar">${st.avatar}</div>
