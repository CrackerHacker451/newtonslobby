    function switchLobbyView(view) {
      playAudio('click');
      document.getElementById('pill-squads').classList.toggle('active', view === 'squads');
      document.getElementById('pill-builders').classList.toggle('active', view === 'builders');
      document.getElementById('lobby-squads-view').style.display = view === 'squads' ? 'block' : 'none';
      document.getElementById('lobby-builders-view').style.display = view === 'builders' ? 'block' : 'none';
    }

