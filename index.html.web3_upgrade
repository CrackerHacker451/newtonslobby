    /* ──────────────────────────────────────────────────────────────────────
       6. UNIAI TERMINAL COPILOT & 0G COMPUTE WALLET
       ────────────────────────────────────────────────────────────────────── */
    const terminalBody = document.getElementById('terminal-body');
    const termInput = document.getElementById('term-input');
    let walletCredits = 1.271;

    function handleTermKey(e) {
      if (e.key === 'Enter') submitTermInput();
    }

    function handleChipClick(promptText) {
      termInput.value = promptText;
      submitTermInput();
    }

    function clearTerminal() {
      playAudio('click');
      terminalBody.innerHTML = `
        <div class="term-msg system">[TERMINAL CLEARED] 0G Private Enclave Session Active.</div>
      `;
    }

    function submitTermInput() {
      const q = termInput.value.trim();
      if (!q) return;
      playAudio('beep');

      appendTermMsg(q, 'user');
      termInput.value = '';

      walletCredits = Math.max(0.1, Number((walletCredits - 0.012).toFixed(3)));
      document.getElementById('wallet-balance').textContent = walletCredits.toFixed(3);
      const remainingPct = Math.round((walletCredits / 1.5) * 100);
      document.getElementById('meter-percent-txt').textContent = `${remainingPct}% remaining`;
      document.getElementById('meter-fill-bar').style.width = `${remainingPct}%`;

      setTimeout(() => {
        const responseHtml = generateCopilotResponse(q);
        appendTermMsg(responseHtml, 'ai');
        playAudio('success');
      }, 400);
    }

    function appendTermMsg(content, role) {
      const msg = document.createElement('div');
      msg.className = 'term-msg ' + role;
      msg.innerHTML = content;
      terminalBody.appendChild(msg);
      terminalBody.scrollTop = terminalBody.scrollHeight;
    }

    function generateCopilotResponse(query) {
      const lower = query.toLowerCase();
      if (lower.includes('calculus') || lower.includes('derivative')) {
        return `📐 <strong>0G Calculus Copilot Analysis:</strong><br>
The derivative measures the instantaneous rate of change of a function:<br>
<div class="term-code-block">
f'(x) = lim_{h -> 0} [ f(x + h) - f(x) ] / h
<button class="copy-code-btn" onclick="copyText('f\'(x) = lim_{h -> 0} [ f(x + h) - f(x) ] / h')">Copy</button>
</div>
<strong>Core Rules Verified on 0G ZK Enclave:</strong><br>
• Power Rule: d/dx [x^n] = n * x^(n-1)<br>
• Product Rule: d/dx [u * v] = u'v + uv'<br>
• Chain Rule: d/dx [f(g(x))] = f'(g(x)) * g'(x)<br>
<em>Attestation: ZK-SNARK proof generated in 14ms. Ready for assignment submission.</em>`;
      } else if (lower.includes('c++') || lower.includes('debug')) {
        return `🛠️ <strong>C++ Zero-Knowledge Code Audit:</strong><br>
Detected potential memory leak / dangling pointer in your pointer arithmetic:<br>
<div class="term-code-block">
// Optimized Modern C++20 Memory-Safe Pattern:
#include &lt;memory&gt;
#include &lt;vector&gt;

auto squadData = std::make_unique&lt;std::vector&lt;std::string&gt;&gt;();
squadData-&gt;push_back("Builder_0x3F89");
// Automatic zero-overhead RAII deallocation
<button class="copy-code-btn" onclick="copyText('auto squadData = std::make_unique<std::vector<std::string>>();')">Copy</button>
</div>
<em>Result: 0 memory leaks, 100% cache locality achieved.</em>`;
      } else if (lower.includes('scan') || lower.includes('lecture')) {
        return `📄 <strong>0G Private Computer Optical OCR:</strong><br>
Scanned 4 pages of handwritten engineering notes.<br>
• <strong>Key Topic:</strong> Distributed Consensus & Arkiv DB-Chain TTLs.<br>
• <strong>Summary:</strong> Ephemeral state requires <code>ExpirationTime.fromDays(30)</code> to minimize storage bloat while guaranteeing verifiable validity for campus semesters.`;
      } else if (lower.includes('benchmark')) {
        return `⚡ <strong>0G ZK-SNARK Engine Benchmark:</strong><br>
• Proof System: Plonky2 / Groth16 hybrid<br>
• Proving Time: 16.8 ms<br>
• Verification Gas: 0.000018 ETH (Layer 2 subsidized)<br>
• Status: 100% Validated on Newton's Lobby node cluster.`;
      } else {
        return `💡 <strong>0G AI Synthesis for "${query}":</strong><br>
Processed through our privacy-preserving neural cluster. All computations are verifiable via cryptographic zero-knowledge proofs and state-synced to Arkiv DB-Chain. How can I expand on this for your hackathon project?`;
      }
    }

    function copyText(text) {
      navigator.clipboard?.writeText(text);
      showToast('success', 'Copied to Clipboard', text);
    }

    function claimDailyGasDrop() {
      walletCredits = Number((walletCredits + 0.25).toFixed(3));
      document.getElementById('wallet-balance').textContent = walletCredits.toFixed(3);
      playAudio('success');
      showToast('success', 'Gas Drop Claimed', 'Claimed +0.25 iAI compute credits! Your campus daily allocation has been updated.');
    }

