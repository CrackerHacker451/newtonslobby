    function renderDaresGrid(currentIndex) {
      const grid = document.getElementById('dares-grid');
      grid.innerHTML = OFFICIAL_DARES.map((dare, idx) => `
        <div class="dare-card ${idx === currentIndex ? 'current' : ''}" onclick="selectDare(${idx})">
          <div class="dare-num-badge">DARE 0${dare.id} • ${idx === currentIndex ? 'ACTIVE NOW' : 'IN ROTATION'}</div>
          <div class="dare-card-title">${dare.title}</div>
          <div class="dare-card-desc">${dare.desc}</div>
          <div class="dare-card-footer">
            <span class="dare-prize">${dare.prize}</span>
            <span style="color:var(--c-text-muted);">${dare.submissions} proofs submitted</span>
          </div>
        </div>
      `).join('');
    }

    function selectDare(idx) {
      playAudio('click');
      const dare = OFFICIAL_DARES[idx];
      document.getElementById('active-dare-title').textContent = `Dare #0${dare.id}: ${dare.title}`;
      document.getElementById('active-dare-desc').textContent = dare.desc;
    }

    function updateDareRotation() {
      const now = new Date();
      const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0, 0);
      const diffMs = now - midnight;
      const totalMinutes = Math.floor(diffMs / 60000);
      const current30MinWindow = Math.floor(totalMinutes / 30);
      const dareIndex = current30MinWindow % 6;

      const activeDare = OFFICIAL_DARES[dareIndex];
      document.getElementById('active-dare-title').textContent = `Dare #0${activeDare.id}: ${activeDare.title}`;
      document.getElementById('active-dare-desc').textContent = activeDare.desc;

      renderDaresGrid(dareIndex);

      const msIntoCurrentWindow = diffMs % (30 * 60 * 1000);
      const msRemaining = (30 * 60 * 1000) - msIntoCurrentWindow;
      const remSec = Math.floor((msRemaining / 1000) % 60);
      const remMin = Math.floor(msRemaining / 60000);

      const formattedMin = String(remMin).padStart(2, '0');
      const formattedSec = String(remSec).padStart(2, '0');
      document.getElementById('dare-countdown-text').textContent = `Next Dare in ${formattedMin}:${formattedSec}`;
    }

    setInterval(updateDareRotation, 1000);
    updateDareRotation();

