      playAudio('success');
      showToast('success', 'Squad Request Sent', `You have joined the waitlist for ${squadName}. Encrypted invitation sent to your World ID.`);
    }

    function viewStudentPass(name, college, roll, batch, branch, avatar) {
      document.getElementById('pass-name').textContent = name;
      document.getElementById('pass-college').textContent = college;
      document.getElementById('pass-roll').textContent = roll;
      document.getElementById('pass-batch').textContent = batch;
      document.getElementById('pass-branch').textContent = branch;
      document.getElementById('pass-avatar').textContent = avatar;
      openModal('modal-pass');
